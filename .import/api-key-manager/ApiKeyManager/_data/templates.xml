<?xml version="1.0" encoding="utf-8"?>
<templates>
  <template type="public" title="cav7_api_key_account" version_id="1010010" version_string="1.1.0"><![CDATA[<xf:title>{{ phrase('cav7_api_key') }}</xf:title>
<xf:wrap template="account_wrapper"/>

<xf:if is="$apiKey">
	<div class="block">
		<div class="block-container">
			<div class="block-body">
				<xf:inforow label="Key"><code>{{ $apiKey.key_prefix }}...</code></xf:inforow>
				<xf:inforow label="Created">{{ date_time($apiKey.created_date) }}</xf:inforow>
				<xf:if is="$apiKey.last_used_date">
					<xf:inforow label="Last used">{{ date_time($apiKey.last_used_date) }}</xf:inforow>
				</xf:if>
				<xf:inforow label="{{ phrase('cav7_api_key_permissions') }}"
					hint="{{ phrase('cav7_api_key_permissions_explain') }}">
					<xf:if is="$apiKey.Scopes is not empty">
						<xf:foreach loop="$apiKey.Scopes" value="$grant">
							<span class="label" title="{{ $grant.ScopeDef.description }}">{{ $grant.ScopeDef.title }}</span>
						</xf:foreach>
					<xf:else />
						<em>{{ phrase('cav7_api_key_no_scopes') }}</em>
					</xf:if>
				</xf:inforow>
			</div>
			<div class="block-rowMessage block-rowMessage--warning">
				Keep your API key secret. It grants access to the 7Cav API on your behalf.
			</div>
			<div class="block-footer block-footer--separated">
				<form method="post" action="{{ link('account/api-key-rotate') }}" data-xf-submit-confirm="{{ phrase('cav7_api_key_rotate_confirm') }}" style="display:inline-block;margin-right:8px;">
					<xf:csrf />
					<button type="submit" class="button">Rotate Key</button>
				</form>
				<form method="post" action="{{ link('account/api-key-revoke') }}" data-xf-submit-confirm="{{ phrase('cav7_api_key_revoke_confirm') }}" style="display:inline-block;">
					<xf:csrf />
					<button type="submit" class="button button--danger">Revoke Key</button>
				</form>
			</div>
		</div>
	</div>
<xf:else />
	<div class="block">
		<div class="block-container">
			<div class="block-body">
				<xf:inforow>You don't have an API key yet. Generate one to authenticate with the 7Cav API.</xf:inforow>
			</div>
			<div class="block-footer block-footer--separated">
				<form method="post" action="{{ link('account/api-key-create') }}">
					<xf:csrf />
					<button type="submit" class="button button--cta">Generate API Key</button>
				</form>
			</div>
		</div>
	</div>
</xf:if>]]></template>

  <template type="public" title="cav7_api_key_account_newkey" version_id="1020110" version_string="1.2.1"><![CDATA[<xf:title>{{ phrase('cav7_api_key') }}</xf:title>
<xf:wrap template="account_wrapper"/>

<div class="block">
	<div class="block-container">
		<div class="block-body">
			<div class="block-rowMessage block-rowMessage--important">
				<strong>{{ phrase('cav7_api_key_new_key_warning') }}</strong>
			</div>
			<xf:textboxrow label="Your API Key"
				name="_cav7_key_display"
				value="{$rawKey}"
				inputclass="input--mono"
				readonly="true"
				explain="Store this somewhere safe — it cannot be retrieved again." />
			<xf:textboxrow label="Authorization header"
				name="_cav7_key_auth_header"
				value="Authorization: Bearer {$rawKey}"
				inputclass="input--mono"
				readonly="true"
				explain="Send this header with every API request. The Bearer scheme is required — sending the key without it will be rejected. Always use the full cav7_-prefixed key shown above, not the shortened prefix… preview displayed on your key list." />
			<xf:textboxrow label="Example request"
				name="_cav7_key_curl_example"
				value="curl -H &quot;Authorization: Bearer {$rawKey}&quot; https://api.7cav.us/api/v1/milpacs/awol"
				inputclass="input--mono"
				readonly="true" />
		</div>
		<div class="block-footer">
			<a href="{{ link('account/api-key') }}" class="button">Done</a>
		</div>
	</div>
</div>]]></template>

  <template type="admin" title="cav7_api_key_list" version_id="1010010" version_string="1.1.0"><![CDATA[<xf:title>{{ phrase('cav7_api_keys') }}</xf:title>

<div class="block">
	<div class="block-container">
		<h2 class="block-header">{{ phrase('cav7_api_keys') }}</h2>
		<xf:if is="$apiKeys.count()">
			<table class="dataList">
				<thead>
					<tr>
						<th>User</th>
						<th>Key Prefix</th>
						<th>Scopes</th>
						<th>Created</th>
						<th>Last Used</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					<xf:foreach loop="$apiKeys" value="$key">
						<tr>
							<td>
								<xf:if is="$key.User">
									<a href="{{ link('users/edit', $key.User) }}">{{ $key.User.username }}</a>
								<xf:else />
									<em>Unknown (user_id: {{ $key.user_id }})</em>
								</xf:if>
							</td>
							<td><code>{{ $key.key_prefix }}...</code></td>
							<td>
								<xf:if is="$key.Scopes is not empty">
									<xf:foreach loop="$key.Scopes" value="$grant">
										<span class="label" title="{{ $grant.ScopeDef.scope_name }}">{{ $grant.ScopeDef.title }}</span>
									</xf:foreach>
								<xf:else />
									<em>None</em>
								</xf:if>
							</td>
							<td>{{ date_time($key.created_date) }}</td>
							<td>
								<xf:if is="$key.last_used_date">
									{{ date_time($key.last_used_date) }}
								<xf:else />
									<em>Never</em>
								</xf:if>
							</td>
							<td class="dataList-col--action">
								<form method="post" action="{{ link('cav7-api-keys/revoke') }}" data-xf-submit-confirm="Revoke this user's API key? They will lose API access immediately.">
									<input type="hidden" name="key_id" value="{{ $key.key_id }}" />
									<xf:csrf />
									<button type="submit" class="button button--danger button--small">Revoke</button>
								</form>
							</td>
						</tr>
					</xf:foreach>
				</tbody>
			</table>
		<xf:else />
			<div class="block-body">
				<div class="block-rowMessage">No API keys have been generated yet.</div>
			</div>
		</xf:if>
	</div>
</div>]]></template>

  <template type="admin" title="cav7_api_scope_list" version_id="1020010" version_string="1.2.0"><![CDATA[<xf:title>{{ phrase('cav7_api_scopes') }}</xf:title>

<xf:pageaction>
	<xf:button href="{{ link('cav7-api-scopes/add') }}" icon="add">Add scope</xf:button>
</xf:pageaction>

<div class="block">
	<div class="block-container">
		<xf:if is="$scopes.count()">
			<table class="dataList">
				<thead>
					<tr>
						<th>Name</th>
						<th>Title</th>
						<th>Gated to groups</th>
						<th>Active</th>
						<th>Order</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					<xf:foreach loop="$scopes" value="$scope">
						<tr>
							<td><code>{{ $scope.scope_name }}</code></td>
							<td>{{ $scope.title }}</td>
							<td>
								<xf:if is="$scope.is_gated">
									<code>{{ $scope.user_group_ids }}</code>
								<xf:else />
									<em>Ungated (everyone with a key)</em>
								</xf:if>
							</td>
							<td>
								<xf:if is="$scope.is_active">
									<span class="label label--success">Active</span>
								<xf:else />
									<span class="label">Disabled</span>
								</xf:if>
							</td>
							<td>{{ $scope.display_order }}</td>
							<td class="dataList-col--action">
								<a class="button button--small" href="{{ link('cav7-api-scopes/edit', $scope) }}">Edit</a>
								<a class="button button--small button--danger" href="{{ link('cav7-api-scopes/delete', $scope) }}">Delete</a>
							</td>
						</tr>
					</xf:foreach>
				</tbody>
			</table>
		<xf:else />
			<div class="block-body">
				<div class="block-rowMessage">{{ phrase('cav7_api_scope_no_scopes') }}</div>
			</div>
		</xf:if>
	</div>
</div>]]></template>

  <template type="admin" title="cav7_api_scope_edit" version_id="1020010" version_string="1.2.0"><![CDATA[<xf:title>{{ phrase('cav7_api_scope') }}<xf:if is="$scope.scope_id">: {$scope.title}</xf:if></xf:title>

<xf:form action="{{ link('cav7-api-scopes/save', $scope) }}" ajax="true" class="block">
	<div class="block-container">
		<div class="block-body">
			<xf:if is="$scope.scope_id">
				<xf:inforow label="{{ phrase('cav7_api_scope_name') }}">
					<code>{{ $scope.scope_name }}</code>
				</xf:inforow>
			<xf:else />
				<xf:textboxrow name="scope_name" value="{$scope.scope_name}"
					label="{{ phrase('cav7_api_scope_name') }}"
					explain="{{ phrase('cav7_api_scope_name_explain') }}" />
			</xf:if>

			<xf:textboxrow name="title" value="{$scope.title}"
				label="Title"
				explain="{{ phrase('cav7_api_scope_title_explain') }}" />

			<xf:textarearow name="description" value="{$scope.description}"
				label="Description" rows="3"
				explain="{{ phrase('cav7_api_scope_description_explain') }}" />

			<xf:formrow label="{{ phrase('cav7_api_scope_user_groups') }}" explain="{{ phrase('cav7_api_scope_user_groups_explain') }}">
				<xf:select name="user_group_ids[]" multiple="true" value="{{ explode(',', $scope.user_group_ids) }}" size="8">
					<xf:foreach loop="$userGroups" key="$groupId" value="$groupTitle">
						<xf:option value="{$groupId}">{$groupTitle}</xf:option>
					</xf:foreach>
				</xf:select>
			</xf:formrow>

			<xf:numberboxrow name="display_order" value="{$scope.display_order}"
				label="Display order" min="0" />

			<xf:checkboxrow>
				<xf:option name="is_active" value="1" selected="{$scope.is_active}" label="Active" />
			</xf:checkboxrow>
		</div>
		<xf:submitrow icon="save" sticky="true" />
	</div>
</xf:form>]]></template>

  <template type="admin" title="cav7_api_scope_delete" version_id="1010010" version_string="1.1.0"><![CDATA[<xf:title>{{ phrase('cav7_api_scope') }}: {{ $scope.title }}</xf:title>

<xf:form action="{{ link('cav7-api-scopes/delete', $scope) }}" class="block">
	<div class="block-container">
		<div class="block-body">
			<div class="block-rowMessage">{{ phrase('cav7_api_scope_delete_confirm') }}</div>
		</div>
		<xf:submitrow icon="delete" sticky="true" />
	</div>
</xf:form>]]></template>
</templates>
