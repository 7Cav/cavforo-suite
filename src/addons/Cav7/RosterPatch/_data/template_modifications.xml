<?xml version="1.0" encoding="utf-8"?>
<template_modifications>
  <modification type="public" template="nf_rosters_user_view" modification_key="cav7RosterPatchRecordDateUtc" description="Render the milpac service-record date in UTC so it reads the same for every viewer and matches the edit form" execution_order="10" enabled="1" action="preg_replace">
    <find><![CDATA[#\{\{\s*date\s*\(\s*\$record\.record_date\s*(?:,[^()]*)?\)\s*\}\}#]]></find>
    <replace><![CDATA[{$record.getRecordDate()}]]></replace>
  </modification>
  <modification type="public" template="nf_rosters_user_view" modification_key="cav7RosterPatchAwardDateUtc" description="Render the milpac award date in UTC so it reads the same for every viewer and matches the edit form" execution_order="10" enabled="1" action="preg_replace">
    <find><![CDATA[#\{\{\s*date\s*\(\s*\$award\.award_date\s*(?:,[^()]*)?\)\s*\}\}#]]></find>
    <replace><![CDATA[{$award.getAwardDate()}]]></replace>
  </modification>
</template_modifications>
