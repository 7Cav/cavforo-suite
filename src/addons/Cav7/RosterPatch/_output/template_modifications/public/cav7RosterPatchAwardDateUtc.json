{
    "template": "nf_rosters_user_view",
    "description": "Render the milpac award date in UTC so it reads the same for every viewer and matches the edit form",
    "execution_order": 10,
    "enabled": true,
    "action": "preg_replace",
    "find": "#\\{\\{\\s*date\\s*\\(\\s*\\$award\\.award_date\\s*(?:,[^{}()]*)?\\)\\s*\\}\\}#",
    "replace": "{$award.getAwardDate()}"
}