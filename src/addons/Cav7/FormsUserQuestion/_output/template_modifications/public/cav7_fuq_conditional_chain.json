{
    "template": "snog_forms_question_macros",
    "description": "Add a forum user question branch to the conditional question chain, which has no else branch",
    "execution_order": 10,
    "enabled": true,
    "action": "str_replace",
    "find": "<xf:if is=\"$hiddenquestion.type == 'text'\">",
    "replace": "<xf:if is=\"$hiddenquestion.isCav7FuqForumUserType()\">\n\t\t\t\t\t\t\t<xf:macro id=\"cav7_fuq_question_macros::name_box\" arg-question=\"{$hiddenquestion}\" arg-canSubmit=\"{canSubmit}\" arg-row=\"{$row}\" />\n\t\t\t\t\t\t<xf:elseif is=\"$hiddenquestion.type == 'text'\" />"
}